# Track Python source and explicitly selected project/reference files only.
# Directory traversal keeps Python audit utilities in docs/ trackable without
# including their reports, images or other working documents.
*
!*/
!*.py
!/.gitignore
!/README.md
!/README_DETAILED.md
!/GETTING_STARTED.md
!/pyproject.toml
!/environment.yml
!/requirements.txt
!/requirements-diagnostics.txt
!/bin/glacier-offsets
!/src/glacier_offsets/defaults.yaml

# Reference configurations. Other local/generated configs remain ignored.
!/configs/defaults.yaml
!/configs/pair.example.yaml
!/configs/pair.initialized.example.yaml
!/configs/pair.constant.yaml
!/configs/pair.pig.yaml
!/configs/pair.pig.velocity.yaml
!/configs/pair.pig.aoi.yaml
!/configs/stack.example.yaml
!/configs/stack.isce2.example.yaml
!/configs/stack.merge-first.example.yaml
!/configs/stack.swath-corrected.example.yaml
!/configs/stack.larsen.2018-reference.example.yaml
!/configs/calibrations/larsen-2017h1-spacecraft.json
!/configs/calibrations/larsen-2018-spacecraft.json
!/configs/stack.pig.yaml
!/configs/stack.pig.validity.yaml
!/configs/stack.pig.interior.yaml
!/docs/stack-processing/README.md
!/docs/stack-processing/SWATH_CORRECTION_ENHANCEMENT.md
!/docs/stack-processing/SWATH_CORRECTION_METHOD.md
!/docs/stack-processing/HANDOFF_2026-10-24.md
!/docs/stack-processing/handoff-2026-10-24/state.json
!/docs/stack-processing/handoff-2026-10-24/independent-swath-overlap.json
!/docs/stack-processing/handoff-2026-10-24/independent-swath-differences.png
!/docs/stack-processing/handoff-2026-10-24/hybrid-full-pair.json
!/docs/stack-processing/handoff-2026-10-24/hybrid-production-review.json
!/docs/stack-processing/mosaic-parity.json
!/docs/stack-processing/validation.json
!/docs/stack-processing/validity-audit.json
!/docs/stack-processing/boundary-investigation/README.md
!/docs/stack-processing/boundary-investigation/native-comparison/report.json
!/docs/stack-processing/boundary-investigation/native-comparison/join-1-range-20000.png
