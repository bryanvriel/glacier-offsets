# Exclude entire data/output/document/runtime trees, including the data symlink.
/data
/work
/plans
/.runtime
/build
/dist
wheel-smoke/
site-packages/
/.venv
/venv
/.agents
/.codex
/.aws
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
